<svg xmlns='http://www.w3.org/2000/svg' width='512' height='512' viewBox='0 0 512 512'>
  <defs>
    <radialGradient id='bgGrad' cx='30%' cy='20%' r='90%'>
      <stop offset='0%' stop-color='#06b6d4'/>
      <stop offset='35%' stop-color='#3b82f6'/>
      <stop offset='70%' stop-color='#1e1b4b'/>
      <stop offset='100%' stop-color='#030712'/>
    </radialGradient>
    <linearGradient id='glassBorder' x1='0%' y1='0%' x2='100%' y2='100%'>
      <stop offset='0%' stop-color='rgba(255,255,255,0.8)'/>
      <stop offset='50%' stop-color='rgba(255,255,255,0.1)'/>
      <stop offset='100%' stop-color='rgba(255,255,255,0.4)'/>
    </linearGradient>
    <linearGradient id='glow' x1='0%' y1='0%' x2='0%' y2='100%'>
      <stop offset='0%' stop-color='#38bdf8'/>
      <stop offset='100%' stop-color='#818cf8'/>
    </linearGradient>
    <filter id='shadow' x='-20%' y='-20%' width='140%' height='140%'>
      <feDropShadow dx='0' dy='12' stdDeviation='16' flood-color='rgba(0,0,0,0.5)'/>
    </filter>
  </defs>
  
  <rect width='512' height='512' rx='128' fill='url(#bgGrad)'/>
  <circle cx='256' cy='256' r='180' fill='rgba(255,255,255,0.06)' stroke='url(#glassBorder)' stroke-width='4' filter='url(#shadow)'/>
  <circle cx='256' cy='256' r='150' fill='rgba(15,23,42,0.5)' stroke='rgba(255,255,255,0.15)' stroke-width='2'/>
  
  <line x1='256' y1='120' x2='256' y2='136' stroke='rgba(255,255,255,0.8)' stroke-width='4' stroke-linecap='round'/>
  <line x1='256' y1='376' x2='256' y2='392' stroke='rgba(255,255,255,0.8)' stroke-width='4' stroke-linecap='round'/>
  <line x1='120' y1='256' x2='136' y2='256' stroke='rgba(255,255,255,0.8)' stroke-width='4' stroke-linecap='round'/>
  <line x1='376' y1='256' x2='392' y2='256' stroke='rgba(255,255,255,0.8)' stroke-width='4' stroke-linecap='round'/>
  
  <line x1='256' y1='256' x2='256' y2='165' stroke='url(#glow)' stroke-width='8' stroke-linecap='round'/>
  <line x1='256' y1='256' x2='330' y2='256' stroke='#ffffff' stroke-width='6' stroke-linecap='round'/>
  <circle cx='256' cy='256' r='12' fill='#38bdf8' filter='url(#shadow)'/>
  <circle cx='256' cy='256' r='5' fill='#ffffff'/>
</svg>
